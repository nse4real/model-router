# Names and placeholders only. Mock defaults work without any .env file.
# This project does not load .env automatically.
PROVIDER_MODE=PLACEHOLDER_MOCK_MODE
DATABASE_URL=PLACEHOLDER_POSTGRES_DSN
REDIS_URL=PLACEHOLDER_REDIS_URL
# Optional, unverified real-provider adapter only; never needed for mocks:
# OPENAI_API_KEY=PLACEHOLDER
# ANTHROPIC_API_KEY=PLACEHOLDER
# OLLAMA_API_BASE=PLACEHOLDER

# Real entry points additionally require --real. Leave confirmation unset for mocks.
# ROUTER_CONFIRM_REAL_SPEND=YES
# ROUTER_CONFIG=PATH_TO_VERIFIED_VERSIONED_CONFIG

# Ledger statements have a separate budget from the request deadline.
LEDGER_STATEMENT_TIMEOUT_MS=2000
# Persist this directory across container restarts; contains paid response text on write failures.
LEDGER_RESPONSE_STORE=results/settlement-recovery.sqlite
